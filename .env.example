# Copy to .env.release.local and fill locally. .env.release.local is ignored.

# Signing. Optional if the script can auto-detect a Developer ID Application identity.
QUOTA_CALENDAR_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Preferred notarization option if you store credentials in Keychain:
# xcrun notarytool store-credentials quota-calendar-notary --apple-id you@example.com --team-id TEAMID --password xxxx-xxxx-xxxx-xxxx
QUOTA_CALENDAR_NOTARY_PROFILE="quota-calendar-notary"

# Alternative Apple ID notarization credentials:
# APPLE_ID="you@example.com"
# APPLE_TEAM_ID="TEAMID"
# APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Alternative App Store Connect API key notarization credentials:
# ASC_KEY_ID="XXXXXXXXXX"
# ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# ASC_KEY_PATH="$HOME/private/AuthKey_XXXXXXXXXX.p8"
